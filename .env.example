# TaskGate needs no environment variables for local runs or `make demo`.
# The GitHub client (`taskgate check --pr` and `taskgate publish`) reads these:
#
# Token for listing a pull request's files, the summary comment and the check
# run. In GitHub Actions: ${{ github.token }} with pull-requests: write and
# checks: write.
# GITHUB_TOKEN=
# Base URL of the GitHub REST API. The tests and `make demo` point it at the
# in-process fake (taskgate.fakegithub).
# TASKGATE_GITHUB_API=https://api.github.com
# OWNER/NAME, the default for --repo (set by GitHub Actions).
# GITHUB_REPOSITORY=
